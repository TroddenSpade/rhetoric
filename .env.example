# Copy to .env.local for local development, then restart `npm run dev`.
# Both values come from Supabase → Project Settings → API.
#
# Use the project root URL (https://<ref>.supabase.co), not the /rest/v1/
# endpoint shown next to it. The app appends the API paths itself.
#
# The anon key is public by design. It only grants access to the signed-in
# user's own row because of the row-level security policies in
# supabase/schema.sql — never put the service_role key in a Vite app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
