{
  "name": "rhetoric",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rhetoric — a writing studio for range, precision and structure.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:pages": "VITE_BASE=/rhetoric/ vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host",
    "test": "node --test",
    "sync:dictionary": "node scripts/sync-dictionary.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
